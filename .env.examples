# ===========================
# EJEMPLOS DE CONFIGURACIÓN .env
# ===========================

# ===========================
# 1. CONFIGURACIÓN ACTUAL (FUNCIONANDO)
# ===========================
# Esta es tu configuración actual que ya funciona
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_COLLECTION_NAME=qwen2.5-7b-instruct
CHUNK_SIZE=800
CHUNK_OVERLAP=80
ENABLE_INCREMENTAL_UPDATES=true
ENABLE_METADATA_ENRICHMENT=true
BATCH_SIZE=100

# ===========================
# 2. DESARROLLO/TESTING (RÁPIDO)
# ===========================
# Para desarrollo y pruebas - procesa menos documentos más rápido
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=bge-m3:567m
# CHUNK_SIZE=400
# CHUNK_OVERLAP=40
# MAX_DOCUMENTS=10
# ENABLE_INCREMENTAL_UPDATES=false
# BATCH_SIZE=50

# ===========================
# 3. PRODUCCIÓN OPTIMIZADA (MEJOR CALIDAD)
# ===========================
# Para máximo rendimiento y calidad
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=bge-m3:567m
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=120
# BATCH_SIZE=200
# ENABLE_INCREMENTAL_UPDATES=true

# ===========================
# 4. OPENAI (CLOUD)
# ===========================
# Para usar OpenAI en lugar de Ollama local
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-tu_clave_real_aqui
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# CHUNK_SIZE=800
# CHUNK_OVERLAP=80

# ===========================
# 5. SERVIDOR OLLAMA PERSONALIZADO
# ===========================
# Si tienes Ollama en otro servidor
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=bge-m3:567m
# OLLAMA_BASE_URL=http://mi-servidor:11434
# CHUNK_SIZE=800
# CHUNK_OVERLAP=80

