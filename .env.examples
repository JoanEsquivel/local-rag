# ===========================
# .env CONFIGURATION EXAMPLES
# ===========================
# Different configurations for various use case scenarios

# ===========================
# 1. CURRENT CONFIGURATION (WORKING) ⭐
# ===========================
# This is your current optimized configuration that already works perfectly
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_COLLECTION_NAME=qwen2.5-7b-instruct
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
CHUNK_SIZE=800
CHUNK_OVERLAP=80
RETRIEVAL_K=5
LLM_TEMPERATURE=0.0
ENABLE_INCREMENTAL_UPDATES=true
ENABLE_METADATA_ENRICHMENT=true
ENABLE_CONTEXT_FILTERING=true
ENABLE_RESPONSE_CLEANING=true
BATCH_SIZE=100
QUERY_OUTPUT_FORMAT=json
INCLUDE_DEBUG_INFO=false

# ===========================
# 2. DEVELOPMENT/TESTING 🔧
# ===========================
# For development and testing - processes fewer documents faster
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
CHUNK_SIZE=400                       # Smaller chunks = faster processing
CHUNK_OVERLAP=40
RETRIEVAL_K=3                        # Fewer documents = faster responses
MAX_DOCUMENTS=10                     # Limit dataset for testing
LLM_TEMPERATURE=0.0                  # Deterministic for reproducible tests
ENABLE_INCREMENTAL_UPDATES=false     # Always rebuild for clean tests
ENABLE_METADATA_ENRICHMENT=false     # Less overhead
BATCH_SIZE=50                        # Smaller batches
INCLUDE_DEBUG_INFO=true              # Debug for troubleshooting
QUERY_OUTPUT_FORMAT=structured       # More readable for development

# ===========================
# 3. PRODUCTION OPTIMIZED 🚀
# ===========================
# For maximum performance and quality in production
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
CHUNK_SIZE=1200                      # Larger chunks = better context
CHUNK_OVERLAP=120                    # More overlap = better continuity
RETRIEVAL_K=8                        # More documents = better coverage
MAX_CONTEXT_LENGTH=6000              # More context = more complete answers
LLM_TEMPERATURE=0.0                  # Consistency in production
SIMILARITY_THRESHOLD=0.2             # Filter less relevant documents
ENABLE_INCREMENTAL_UPDATES=true      # Efficiency in updates
ENABLE_METADATA_ENRICHMENT=true      # Rich metadata for analytics
ENABLE_CONTEXT_FILTERING=true        # Intelligent filtering
BATCH_SIZE=200                       # Large batches = better throughput
QUERY_OUTPUT_FORMAT=json             # Standard format for APIs

# ===========================
# 4. OPENAI CLOUD ☁️
# ===========================
# For using OpenAI instead of local Ollama
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your_real_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
RAG_LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=800
CHUNK_OVERLAP=80
RETRIEVAL_K=5
LLM_TEMPERATURE=0.1                  # Slightly more creative than Ollama
MAX_CONTEXT_LENGTH=4000
ENABLE_CONTEXT_FILTERING=true
ENABLE_RESPONSE_CLEANING=true
BATCH_SIZE=100
QUERY_OUTPUT_FORMAT=json

# ===========================
# 5. HYBRID (OLLAMA + OPENAI) 🔄
# ===========================
# Local embeddings with cloud LLM for better response quality
EMBEDDING_PROVIDER=ollama            # Local embeddings (faster)
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OLLAMA_BASE_URL=http://localhost:11434
RAG_LLM_PROVIDER=openai             # Cloud LLM (better quality)
OPENAI_API_KEY=sk-your_real_key_here
OPENAI_LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=800
CHUNK_OVERLAP=80
RETRIEVAL_K=6
LLM_TEMPERATURE=0.2                  # More creativity with GPT
ENABLE_CONTEXT_FILTERING=true
ENABLE_RESPONSE_CLEANING=true

# ===========================
# 6. HIGH PRECISION 🎯
# ===========================
# For maximum precision in responses
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
CHUNK_SIZE=600                       # Balance between context and precision
CHUNK_OVERLAP=100                    # More overlap for better continuity
RETRIEVAL_K=10                       # More documents for better coverage
SIMILARITY_THRESHOLD=0.3             # Stricter filter
MAX_CONTEXT_LENGTH=8000              # Maximum possible context
LLM_TEMPERATURE=0.0                  # Maximum determinism
ENABLE_CONTEXT_FILTERING=true        # Active intelligent filtering
ENABLE_METADATA_ENRICHMENT=true      # Rich metadata
ENABLE_RESPONSE_CLEANING=true        # Response cleaning
INCLUDE_DEBUG_INFO=true              # Debug for analysis

# ===========================
# 7. HIGH SPEED ⚡
# ===========================
# For faster responses sacrificing some quality
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
CHUNK_SIZE=400                       # Small chunks
CHUNK_OVERLAP=30                     # Less overlap
RETRIEVAL_K=3                        # Few documents
MAX_CONTEXT_LENGTH=2000              # Limited context
LLM_TEMPERATURE=0.0                  # No extra creativity
ENABLE_CONTEXT_FILTERING=false       # No extra filtering
ENABLE_METADATA_ENRICHMENT=false     # No extra metadata
BATCH_SIZE=50                        # Small batches
QUERY_OUTPUT_FORMAT=text             # Text only, no JSON overhead

# ===========================
# 8. CUSTOM SERVER 🖥️
# ===========================
# For Ollama on remote server or custom configuration
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OLLAMA_BASE_URL=http://my-ollama-server:11434
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
CHROMA_COLLECTION_NAME=my-project-docs
CHUNK_SIZE=800
CHUNK_OVERLAP=80
RETRIEVAL_K=5
ENABLE_CONTEXT_FILTERING=true

# ===========================
# 9. DEBUGGING/ANALYSIS 🔍
# ===========================
# For detailed debugging and system analysis
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
CHUNK_SIZE=800
CHUNK_OVERLAP=80
RETRIEVAL_K=7
LLM_TEMPERATURE=0.0
ENABLE_CONTEXT_FILTERING=true
ENABLE_METADATA_ENRICHMENT=true
ENABLE_RESPONSE_CLEANING=true
INCLUDE_DEBUG_INFO=true              # Complete debug information
QUERY_OUTPUT_FORMAT=structured       # Readable format for analysis
SIMILARITY_THRESHOLD=0.0             # No filters to see everything

# ===========================
# 10. MULTILINGUAL/INTERNATIONAL 🌍
# ===========================
# For content in multiple languages
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3:567m   # BGE-M3 is excellent for multilingual
RAG_LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct # Qwen2.5 supports multiple languages
CHUNK_SIZE=1000                      # Larger chunks for better context
CHUNK_OVERLAP=150                    # More overlap for complex languages
RETRIEVAL_K=6
LLM_TEMPERATURE=0.1                  # Slightly more creative for language nuances
ENABLE_CONTEXT_FILTERING=true
ENABLE_METADATA_ENRICHMENT=true

# ===========================
# USAGE INSTRUCTIONS
# ===========================
# 1. Copy the configuration you prefer
# 2. Paste it into your .env file
# 3. Adjust variables according to your needs
# 4. If you change CHUNK_SIZE or CHUNK_OVERLAP, run:
#    python scripts/database_setup.py --reset
# 5. To test configuration:
#    python scripts/query.py "test question" --verbose

