# ===========================
# DETAILED .env VARIABLES DOCUMENTATION
# ===========================

# ===========================
# EMBEDDING PROVIDER SECTION
# ===========================

EMBEDDING_PROVIDER=ollama
# Options: "ollama", "openai"
# What it does: Selects which service to use for converting text into numerical vectors
# When to change: 
#   - "ollama" for local operation, free, private
#   - "openai" for better quality but requires API key and costs money

OLLAMA_EMBEDDING_MODEL=bge-m3:567m
# What it does: Specifies which Ollama model to use for embeddings
# Recommended models:
#   - bge-m3:567m (current, excellent for multilingual)
#   - nomic-embed-text (alternative, faster)
# How to install: ollama pull bge-m3:567m

OLLAMA_BASE_URL=http://localhost:11434
# What it does: URL where Ollama is running
# When to change: If Ollama is on another server or port

OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# What it does: OpenAI model for embeddings
# Options: text-embedding-3-large, text-embedding-3-small
# Cost: text-embedding-3-large is more expensive but better quality

# ===========================
# DATABASE CONFIGURATION
# ===========================

CHROMA_COLLECTION_NAME=qwen2.5-7b-instruct
# What it does: Name of the "folder" inside ChromaDB where vectors are stored
# When to change: For different projects or when changing embedding model
# Important: If you change this, you need to recreate the database

CHUNK_SIZE=800
# What it does: Maximum size of each text piece (in characters)
# Typical values: 400 (fast), 800 (balanced), 1200 (more context)
# Impact: 
#   - Larger = better context but slower
#   - Smaller = faster but may lose context
# If you change: python scripts/database_setup.py --reset

CHUNK_OVERLAP=80
# What it does: How many characters repeat between consecutive chunks
# Rule: Should be 10-15% of CHUNK_SIZE
# Purpose: Prevents losing information at "cuts"

MAX_DOCUMENTS=
# What it does: Limits how many documents to process (optional)
# Useful for: Testing with large datasets
# Example: MAX_DOCUMENTS=10 to process only 10 pages

# ===========================
# PROCESSING OPTIONS
# ===========================

ENABLE_INCREMENTAL_UPDATES=true
# What it does: Only adds new documents, doesn't duplicate existing ones
# true = Faster on updates
# false = Always rebuilds everything (useful for testing)

ENABLE_METADATA_ENRICHMENT=true
# What it does: Adds extra information like timestamps, statistics
# true = More information but slightly slower
# false = Just basics, faster

BATCH_SIZE=100
# What it does: How many documents to process at once
# Typical values: 50 (less RAM), 100 (balanced), 200 (more RAM but faster)

# ===========================
# RAG QUERY CONFIGURATION
# ===========================

RAG_LLM_PROVIDER=ollama
# What it does: Which LLM to use for generating responses (can be different from embedding)
# Options: "ollama", "openai"
# Hybrid strategy: ollama for embeddings + openai for responses

OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# What it does: Ollama model for generating responses
# Popular options:
#   - qwen2.5:7b-instruct (current, very good for multiple languages)
#   - llama3.1:8b-instruct (alternative)
#   - deepseek-r1:8b (good for reasoning)

OPENAI_LLM_MODEL=gpt-4o-mini
# What it does: OpenAI model for responses
# Options: gpt-4o-mini (cheap), gpt-4o (better but more expensive)

RETRIEVAL_K=5
# What it does: How many documents to retrieve from database
# Typical values: 3 (fast), 5 (balanced), 10 (more context)
# Impact: More documents = better context but slower and more tokens

SIMILARITY_THRESHOLD=0.0
# What it does: Minimum similarity filter (0.0 = no filter)
# Values: 0.0-1.0 (0.3 = moderate filter, 0.5 = strict filter)
# Purpose: Eliminates less relevant documents

MAX_CONTEXT_LENGTH=4000
# What it does: Maximum characters to send to LLM as context
# Typical values: 2000 (fast), 4000 (balanced), 8000 (maximum context)
# Limitation: LLMs have token limits

LLM_TEMPERATURE=0.0
# What it does: Controls LLM "creativity"
# Values: 0.0 (deterministic), 0.3 (slightly creative), 0.7 (creative), 1.0 (very creative)
# For RAG: Generally 0.0-0.3 for precise responses

LLM_MAX_TOKENS=
# What it does: Maximum tokens the LLM can generate (optional)
# Useful for: Controlling costs in OpenAI or limiting long responses

# ===========================
# QUERY PROCESSING OPTIONS
# ===========================

ENABLE_CONTEXT_FILTERING=true
# What it does: Intelligently filters less relevant documents
# true = Better response quality
# false = Faster but possible irrelevant responses

ENABLE_RESPONSE_CLEANING=true
# What it does: Cleans model artifacts (like <think> tags)
# true = Cleaner responses
# false = Raw model response

QUERY_OUTPUT_FORMAT=json
# What it does: Default format for responses
# Options: "json" (for APIs), "structured" (readable), "text" (answer only)

INCLUDE_DEBUG_INFO=false
# What it does: Includes technical information in responses
# true = Useful for debugging but larger responses
# false = Only essential response

# ===========================
# RECOMMENDATIONS BY SCENARIO
# ===========================

# DEVELOPMENT/TESTING:
# CHUNK_SIZE=400, RETRIEVAL_K=3, INCLUDE_DEBUG_INFO=true, ENABLE_INCREMENTAL_UPDATES=false

# PRODUCTION:
# CHUNK_SIZE=800-1200, RETRIEVAL_K=5-8, ENABLE_CONTEXT_FILTERING=true, LLM_TEMPERATURE=0.0

# HIGH SPEED:
# CHUNK_SIZE=400, RETRIEVAL_K=3, ENABLE_CONTEXT_FILTERING=false, QUERY_OUTPUT_FORMAT=text

# HIGH PRECISION:
# CHUNK_SIZE=800-1000, RETRIEVAL_K=8-10, SIMILARITY_THRESHOLD=0.3, ENABLE_CONTEXT_FILTERING=true

# LOW COST (OpenAI):
# OPENAI_LLM_MODEL=gpt-4o-mini, RETRIEVAL_K=3, MAX_CONTEXT_LENGTH=2000, LLM_MAX_TOKENS=500

